# Overseer MCP — Environment Variables Reference
# Copy this file to your Overseer data directory as `.env` (or run `overseer-mcp init`):
#   Windows:       %LOCALAPPDATA%\overseer\.env
#   macOS / Linux: ~/.local/share/overseer/.env
#
# Never commit real API keys into any repository.
# `overseer-mcp doctor` checks key credits/rate limits via `GET /api/v1/key` (unless `--offline`).
# On MCP clients that support elicitations, `start_run`/`update_config`/`list_models` can also
# prompt interactively for a missing key in-memory without writing to disk.

# --- OpenRouter API Keys ---
# Shared fallback key used when a tier-specific key is not set:
OPENROUTER_API_KEY=

# Optional tier-specific keys (take precedence over OPENROUTER_API_KEY):
OPENROUTER_FREE_API_KEY=
OPENROUTER_CHEAP_API_KEY=
OPENROUTER_HEAVY_API_KEY=

# --- OpenRouter Endpoint ---
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OVERSEER_ALLOW_INSECURE_BASE_URL=0

# --- Model Tier Overrides (optional; config.json or update_config also manages these) ---
# Free tier (must use :free OpenRouter slugs)
# OVERSEER_FREE_DEFAULT_MODEL=particle-ai/particle-1:free
# OVERSEER_FREE_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free

# Cheap tier
# OVERSEER_CHEAP_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017
# OVERSEER_CHEAP_FALLBACK_MODELS=z-ai/glm-5.3-flash

# Heavy tier
# OVERSEER_HEAVY_DEFAULT_MODEL=
# OVERSEER_HEAVY_FALLBACK_MODELS=

# Legacy single-tier aliases (optional)
# OVERSEER_DEFAULT_MODEL=
# OVERSEER_FALLBACK_MODELS=

# --- Runtime Limits & Behaviour ---
# Max concurrent worker loops per run (1..10, default 3)
# OVERSEER_MAX_CONCURRENT_WORKERS=3

# Max retained finished runs & rollback backups per project (default 50)
# OVERSEER_MAX_RUNS_PER_PROJECT=50

# Disable OS desktop completion notifications (1/true/yes)
# OVERSEER_DISABLE_TOASTS=0

# Disable static ruff check inside worker finish() (1/true/yes)
# OVERSEER_DISABLE_RUFF=0

# Require --!strict header on .luau files during static check (1/true/yes)
# OVERSEER_LUAU_REQUIRE_STRICT=0

# --- Advanced Path Overrides ---
# Override the Overseer data directory (keys, config.json, runs, logs)
# OVERSEER_DATA_DIR=

# Override the MCP App HTML bundle path
# OVERSEER_APP_HTML=
